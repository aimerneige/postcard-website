{
  "name": "local-postcard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run tests/core.test.ts",
    "test:e2e": "playwright test",
    "assets": "python3 scripts/prepare-assets.py",
    "test-fixtures": "python3 scripts/generate-test-fixtures.py",
    "predev": "npm run assets",
    "prebuild": "npm run assets",
    "pretest": "npm run assets && npm run test-fixtures",
    "pretest:e2e": "npm run assets && npm run test-fixtures && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}
